[Unit]
Description=DevDeck Server
After=network.target

[Service]
Type=simple
WorkingDirectory=@REPO@
Environment=DEVDECK_HOST=0.0.0.0
Environment=DEVDECK_PORT=8080
# Optional: Secrets/Overrides (z. B. DEVDECK_ADMIN_EMAIL nur für den allerersten Start)
EnvironmentFile=-%h/.config/devdeck/server.env
ExecStart=/usr/bin/env node packages/server/dist/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
