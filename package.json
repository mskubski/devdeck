{
  "name": "devdeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DevDeck – selbst gehostetes Developer Control Plane und Projektgedächtnis",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "node packages/server/dist/index.js",
    "agent": "node packages/agent/dist/index.js",
    "devdeck": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  }
}
